# Neon connection string (Dashboard > Connect). Use the pooled one.
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
BASE_URL=https://loyalty.bunkwise.in
NODE_ENV=production
PORT=3000

# Your WhatsApp number (with country code, digits only) that receives shop password-reset requests
SUPPORT_WHATSAPP=91XXXXXXXXXX

# --- optional (defaults shown) ---
# Proxies in front of the app. 1 = one load balancer (Render, Railway, Heroku, nginx). 2 = e.g. Cloudflare + Render. 0 = none.
# Wrong value = rate limits see the proxy's IP (everyone blocked together) or a spoofable header.
TRUST_PROXY=1
# Neon only: ping the DB every 4 min so it never sleeps (faster first click, but uses compute hours). 0 = off
KEEP_DB_WARM=1
# Max DB connections per app instance. Keep (instances x this) below your database's limit.
DB_POOL_MAX=10
