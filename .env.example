# Neon connection string (Dashboard > Connect). Use the POOLED one here (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASS@HOST-pooler/DB?sslmode=require
# Optional: the direct (unpooled) string, used only by migrations at build time. The Neon-Vercel integration sets it for you.
# DATABASE_URL_UNPOOLED=
BASE_URL=https://loyalty.bunkwise.in
NODE_ENV=production

# Signs login cookies. 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
SESSION_SECRET=
# Protects /api/cron/daily. Vercel sends it automatically when this env var is set.
CRON_SECRET=

# Your WhatsApp number (digits only) that receives shop password-reset requests
SUPPORT_WHATSAPP=91XXXXXXXXXX

# --- optional ---
# Web push alerts for shops (new stamp request). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Proxies in front of the app. Vercel/Render/Railway = 1. Cloudflare + another host = 2. None = 0.
TRUST_PROXY=1
# Max DB connections per app instance (serverless: keep small)
DB_POOL_MAX=4
# Local runs only
PORT=3000
