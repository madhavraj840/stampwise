# Database of each project (env var names come from projects.js). Use Neon's pooled connection string.
STAMPWISE_DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# Optional: keep admin users and the audit log in a different database (default: the Stampwise one, schema "admin")
# ADMIN_DATABASE_URL=
# Required: 32+ random characters. Signs admin sessions and encrypts 2FA secrets. Changing it logs everyone out and breaks 2FA (re-run create-admin).
ADMIN_SECRET=
NODE_ENV=production
